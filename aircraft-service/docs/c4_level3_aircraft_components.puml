@startuml c4_level3_aircraft_components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title "C4 Level 3: Component Diagram - Aircraft & Maintenance Service (CQRS)"

Container_Boundary(aircraft_service, "Aircraft & Maintenance Service (:8081 / :8086)") {
    Component(security_filter, "JwtAuthenticationFilter", "Spring Security", "Valida a assinatura JWT e aplica controlo RBAC.")

    Component(controllers, "REST Controllers", "Spring REST", "AircraftController, AircraftModelController, MaintenanceRecordController, MaintenanceTemplateController.")

    Component(write_services, "Write Use Cases & Services", "Application Layer", "RegisterAircraftUseCase, RegisterAircraftModelUseCase, UpdateAircraftModelUseCase, MaintenanceService.")
    Component(query_services, "Query Services & Use Cases", "Application Layer", "MaintenanceQueryService, GetFleetAvailabilityUseCase, ReadModelInitializer.")

    Component(rabbit_config, "RabbitMQConfig", "Spring @Configuration", "Configura exchanges, filas por instância e serialização JSON.")
    Component(event_pub, "AircraftEventPublisher", "Spring Component", "Publica AircraftEvent, AircraftModelEvent e MaintenanceEvent no broker.")
    Component(event_listener, "AircraftEventListener", "Spring @RabbitListener", "Consome eventos do broker e atualiza os Read Models locais.")

    Component(write_repos, "Write Repositories", "Spring Data JPA", "AircraftRepository, AircraftModelRepository, MaintenanceRecordRepository, MaintenanceTemplateRepository.")
    Component(read_repos, "Read Model Repositories", "Spring Data JPA", "AircraftReadModelRepository, AircraftModelReadModelRepository, MaintenanceReadModelRepository.")
}

Person(user, "Cliente (Admin / Tech / ATCC)", "Inicia pedidos REST")
Container(flight_ops, "Flight Operations Service", "Java", "Cliente P2P agregador")
Container(rabbitmq, "RabbitMQ Broker", "AMQP", "Troca de eventos CQRS")
ContainerDb(db, "Aircraft H2 Database", "H2 In-Memory", "Base de dados isolada da instância")

Rel(user, security_filter, "Pedidos REST", "HTTPS/JWT")
Rel(flight_ops, security_filter, "GET /api/aircraft/{id}", "HTTPS/JWT")
Rel(security_filter, controllers, "Repassa pedido autenticado")

Rel(controllers, write_services, "Comandos (POST/PUT/DELETE)")
Rel(controllers, query_services, "Consultas (GET)")

Rel(write_services, write_repos, "Persiste Write Model")
Rel(write_services, event_pub, "Publica evento de domínio")
Rel(event_pub, rabbitmq, "Envia evento", "AMQP")

Rel(rabbitmq, event_listener, "Entrega evento", "AMQP")
Rel(event_listener, read_repos, "Atualiza Read Models locais")
Rel(rabbit_config, rabbitmq, "Declara topologia AMQP")

Rel(query_services, read_repos, "Lê Read Models locais")

Rel(write_repos, db, "Lê e Escreve", "JDBC")
Rel(read_repos, db, "Lê e Escreve", "JDBC")

@enduml