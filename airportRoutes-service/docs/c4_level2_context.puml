@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Administrador / ATCC", "Gere aeroportos e rotas.")

System_Boundary(platform, "AISafe Platform") {
    Container(airportRoutesService, "Airports & Routes Service", "Java, Spring Boot", "Gere as rotas, aeroportos e lógica de encaminhamento (Portas 8081/8082).")
    Container(aircraftService, "Aircraft Service", "Java, Spring Boot", "Gere o catálogo de aeronaves e disponibilidade da frota.")

    ContainerDb(dbAirports, "Airports DB", "H2 Database", "Armazena dados locais de aeroportos e rotas.")
    ContainerDb(dbAircraft, "Aircraft DB", "H2 Database", "Armazena dados locais de aeronaves.")
}

Rel(user, airportRoutesService, "Faz pedidos de gestão de rotas e aeroportos", "JSON/HTTPS")
Rel(user, aircraftService, "Faz pedidos de gestão de frota", "JSON/HTTPS")

Rel(airportRoutesService, dbAirports, "Lê e escreve dados em", "JPA/JDBC")
Rel(aircraftService, dbAircraft, "Lê e escreve dados em", "JPA/JDBC")
@enduml